{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "paths": {
      "@org/shared-ui": ["./libs/shared-ui/src/index.ts"],
      "@org/shared-models": ["./libs/shared-models/src/index.ts"],
      "@org/shared-auth": ["./libs/shared-auth/src/index.ts"],
      "@org/shared-utils": ["./libs/shared-utils/src/index.ts"],
      "@org/shared-validation": ["./libs/shared-validation/src/index.ts"]
    }
  }
}
