# ==================================
# Application Configuration
# ==================================
NODE_ENV=development
LOG_LEVEL=info

# ==================================
# API Gateway Configuration
# ==================================
API_GATEWAY_PORT=3000
API_GATEWAY_HOST=localhost

# ==================================
# Microservices Ports
# ==================================
AUTH_SERVICE_PORT=3001
STUDENT_SERVICE_PORT=3002
TEACHER_SERVICE_PORT=3003
ADMIN_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005
FILE_SERVICE_PORT=3006
AUDIT_SERVICE_PORT=3007
EXAM_SERVICE_PORT=3008

# ==================================
# Frontend Ports
# ==================================
COLLEGE_SHELL_PORT=4200
STUDENT_MFE_PORT=4201
TEACHER_MFE_PORT=4202
ADMIN_MFE_PORT=4203

# ==================================
# Database Configuration
# ==================================
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root

# Database Names
DB_AUTH=college_auth
DB_STUDENT=college_student
DB_TEACHER=college_teacher
DB_ADMIN=college_admin
DB_NOTIFICATION=college_notification
DB_FILE=college_file
DB_AUDIT=college_audit

# Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT=30000

# ==================================
# JWT Configuration
# ==================================
# IMPORTANT: Generate strong secrets for production
# Use: openssl rand -base64 64
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ==================================
# CORS Configuration
# ==================================
CORS_ORIGIN=http://localhost:4200
CORS_CREDENTIALS=true

# ==================================
# Rate Limiting
# ==================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS_UNAUTHENTICATED=20
RATE_LIMIT_MAX_REQUESTS_STUDENT=100
RATE_LIMIT_MAX_REQUESTS_TEACHER=200
RATE_LIMIT_MAX_REQUESTS_ADMIN=500

# ==================================
# File Upload Configuration
# ==================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation

# Profile picture settings
MAX_PROFILE_PICTURE_SIZE=5242880

# ==================================
# Email Configuration (for notifications)
# ==================================
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=noreply@college.edu
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=College Management System <noreply@college.edu>

# ==================================
# Session Configuration
# ==================================
SESSION_SECRET=your-session-secret-change-this-in-production

# ==================================
# Security Configuration
# ==================================
# Account lockout after failed login attempts
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=900000

# Password requirements
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL_CHAR=true

# ==================================
# Pagination Defaults
# ==================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ==================================
# Frontend API URLs (for SSR)
# ==================================
API_BASE_URL=http://localhost:3000
API_GATEWAY_URL=http://localhost:3000

# ==================================
# Redis Configuration (Optional - for future use)
# ==================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ==================================
# Monitoring & Logging (Optional)
# ==================================
# SENTRY_DSN=
# LOG_FILE_PATH=./logs
# ENABLE_REQUEST_LOGGING=true

# ==================================
# Feature Flags (Optional)
# ==================================
ENABLE_REGISTRATION=true
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=false

# ==================================
# Development Settings
# ==================================
# Set to true to bypass TypeScript project reference warning
NX_IGNORE_UNSUPPORTED_TS_SETUP=true

# ==================================
# Production Settings (Override in production)
# ==================================
# NODE_ENV=production
# LOG_LEVEL=error
# DB_HOST=your-production-db-host
# DB_PASSWORD=your-strong-production-password
# JWT_ACCESS_SECRET=your-production-access-secret
# JWT_REFRESH_SECRET=your-production-refresh-secret
# CORS_ORIGIN=https://your-production-domain.com
# API_BASE_URL=https://api.your-production-domain.com
